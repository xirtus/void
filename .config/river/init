#!/bin/sh

# --- Environment & Autostart ---
export XCURSOR_SIZE=24
export XCURSOR_THEME=Adwaita
export QT_QPA_PLATFORMTHEME=kde
dbus-update-activation-environment --all WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE &
riverctl spawn "pipewire"
riverctl spawn "waybar -c ~/.config/waybar/river_config.jsonc"
riverctl spawn "xwallpaper"

# --- Audio: Alienware x17 R1 ALSA/amixer Fixes ---
# Force 'Input Source' to 'Headset Mic' and enable capture
riverctl spawn "amixer -c 0 cset numid=6 0"
riverctl spawn "amixer -c 0 cset numid=7 0"
riverctl spawn "amixer -c 0 cset numid=9 on"
riverctl spawn "amixer -c 0 cset numid=11 on"
riverctl spawn "amixer -c 0 cset numid=8 100%"
riverctl spawn "amixer -c 0 cset numid=10 100%"
riverctl spawn "amixer -c 0 cset numid=51 100%"
riverctl spawn "amixer -c 0 cset numid=12 100%"
# riverctl spawn "hyprctl setcursor Adwaita 24" # Hyprland specific, using env vars instead

# --- Appearance (Matching Hyprland) ---
riverctl border-width 2
# Focused: Cyan/Green vibe (0x33ccff)
riverctl border-color-focused 0x33ccff
# Inactive: Gray (0x595959)
riverctl border-color-unfocused 0x595959
riverctl background-color 0x1a1a1a

# --- Keyboard Settings ---
riverctl set-repeat 50 300

# --- Keybindings: Essentials ---
riverctl map normal Super Q close
riverctl map normal Super Return spawn /usr/bin/kitty
riverctl map normal Super+Shift M exit
riverctl map normal Super E spawn dolphin
riverctl map normal Super V toggle-float
riverctl map normal Super F toggle-fullscreen
riverctl map normal Super Space spawn fuzzel
riverctl map normal Super R spawn fuzzel

# --- Keybindings: Apps ---
riverctl map normal Super B spawn "brave --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations,WebRTCPipeWireCapturer --disable-gpu-sandbox --ignore-gpu-blocklist --enable-gpu-rasterization --enable-zero-copy"
riverctl map normal Super G spawn "kitty -e env PATH='/home/xirtus_void/.bun/bin:$PATH' /home/xirtus_void/node_modules/.bin/grok"
riverctl map normal Super Y spawn "kitty -e zsh -c 'y'"
riverctl map normal Super S spawn 'nohup steam >/dev/null 2>&1 & disown'

# --- Keybindings: Waybar & Screenshots ---
riverctl map normal Super+Shift R spawn "killall waybar; waybar -c ~/.config/waybar/river_config.jsonc &"
riverctl map normal None Print spawn "grim -g \"\$(slurp)\" - | wl-copy"
riverctl map normal Shift Print spawn "grim - | wl-copy"

# --- Keybindings: Focus & Movement ---
riverctl map normal Super H focus-view left
riverctl map normal Super L focus-view right
riverctl map normal Super K focus-view up
riverctl map normal Super J focus-view down

riverctl map normal Super Left focus-view left
riverctl map normal Super Right focus-view right
riverctl map normal Super Up focus-view up
riverctl map normal Super Down focus-view down

riverctl map normal Super+Shift H swap left
riverctl map normal Super+Shift L swap right
riverctl map normal Super+Shift K swap up
riverctl map normal Super+Shift J swap down

riverctl map normal Super+Shift Left swap left
riverctl map normal Super+Shift Right swap right
riverctl map normal Super+Shift Up swap up
riverctl map normal Super+Shift Down swap down

# --- Keybindings: Resizing (Alt + Vim/Arrows) ---
riverctl map normal Super+Alt H resize horizontal -40
riverctl map normal Super+Alt L resize horizontal 40
riverctl map normal Super+Alt K resize vertical -40
riverctl map normal Super+Alt J resize vertical 40

riverctl map normal Super+Alt Left resize horizontal -40
riverctl map normal Super+Alt Right resize horizontal 40
riverctl map normal Super+Alt Up resize vertical -40
riverctl map normal Super+Alt Down resize vertical 40

# --- Keybindings: Tags (Workspaces) ---
for i in $(seq 1 9)
do
    tags=$((1 << ($i - 1)))
    riverctl map normal Super $i set-focused-tags $tags
    riverctl map normal Super+Shift $i set-view-tags $tags
    riverctl map normal Super+Control $i toggle-focused-tags $tags
    riverctl map normal Super+Shift+Control $i toggle-view-tags $tags
done
all_tags=$(((1 << 32) - 1))
riverctl map normal Super 0 set-focused-tags $all_tags
riverctl map normal Super+Shift 0 set-view-tags $all_tags

# --- Keybindings: Multimedia (wpctl) ---
for mode in normal locked
do
    riverctl map $mode None XF86AudioRaiseVolume spawn "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"
    riverctl map $mode None XF86AudioLowerVolume spawn "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-"
    riverctl map $mode None XF86AudioMute        spawn "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    riverctl map $mode None XF86AudioMicMute     spawn "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
    
    riverctl map $mode None XF86MonBrightnessUp   spawn "brightnessctl -e4 -n2 set 5%+"
    riverctl map $mode None XF86MonBrightnessDown spawn "brightnessctl -e4 -n2 set 5%-"

    riverctl map $mode None XF86AudioPlay  spawn "playerctl play-pause"
    riverctl map $mode None XF86AudioPrev  spawn "playerctl previous"
    riverctl map $mode None XF86AudioNext  spawn "playerctl next"
    
    riverctl map $mode None XF86Bluetooth spawn "rfkill toggle bluetooth"
done

# --- Keybindings: Mouse ---
riverctl map-pointer normal Super BTN_LEFT move-view
riverctl map-pointer normal Super BTN_RIGHT resize-view
riverctl map-pointer normal Super BTN_MIDDLE toggle-float

# --- Layout Configuration ---
# Hyprland gaps: gaps_in=5, gaps_out=20
riverctl spawn "rivertile -view-padding 5 -outer-padding 20 -main-ratio 0.5"
riverctl default-layout rivertile

# --- Passthrough Mode ---
riverctl declare-mode passthrough
riverctl map normal Super F11 enter-mode passthrough
riverctl map passthrough Super F11 enter-mode normal

# --- Rules ---
riverctl rule-add -app-id 'float*' float
riverctl rule-add -app-id "pavucontrol" float
riverctl rule-add -app-id "dolphin" float
